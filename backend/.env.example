# Copiez ce fichier en .env (ignoré par git) et renseignez vos clés.
# En production, définissez ces mêmes variables dans les réglages de l'hébergeur (Render).

# Génération des réponses (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Embeddings pour la recherche (platform.openai.com > API keys)
OPENAI_API_KEY=

# Optionnel : modèle Claude (défaut claude-opus-5 ; moins cher : claude-sonnet-5, claude-haiku-4-5)
# CLAUDE_MODEL=claude-opus-5

# Limites de la démo publique
# RAG_DAILY_BUDGET_USD=2.0
# RAG_MAX_QUESTIONS_PER_HOUR=20
# RAG_MAX_QUESTIONS_PER_DAY=60
# RAG_MAX_DOCUMENTS_PER_SESSION=5

# Django (en production : une vraie clé secrète, DEBUG désactivé)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True

# Copiez ce fichier en .env (ignoré par git) et renseignez votre clé.
# En production, définissez ces mêmes variables dans les réglages de l'hébergeur (Render).

# Clé gratuite Gemini, pour les réponses et la recherche : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel : modèles essayés dans l'ordre quand le quota gratuit du précédent est épuisé
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Limites de la démo publique
# RAG_MAX_QUESTIONS_GLOBAL_PER_DAY=300
# RAG_MAX_QUESTIONS_PER_HOUR=20
# RAG_MAX_QUESTIONS_PER_DAY=60
# RAG_MAX_DOCUMENTS_PER_SESSION=5

# Django (en production : une vraie clé secrète, DEBUG désactivé)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
